# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/complaint_portal?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-change-in-production"

# Email (configure for production)
EMAIL_SERVER_HOST="smtp.gmail.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="your-email@gmail.com"
EMAIL_SERVER_PASSWORD="your-app-password"
EMAIL_FROM="noreply@complaintportal.com"

# File Upload
UPLOAD_DIR="./public/uploads"
MAX_FILE_SIZE=5242880

# Supabase (for chatbot + backend) — https://app.supabase.com
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Gemini (chatbot) — https://aistudio.google.com/app/apikey
NEXT_PUBLIC_GEMINI_API_KEY="your-gemini-api-key"
# Optional server key (if using Vercel API route)
GEMINI_API_KEY="your-gemini-api-key"